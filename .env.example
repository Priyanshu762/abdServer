PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MongoDB Connection String (Local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/affordable_balloons

# JWT Secret for Admin Authentication
JWT_SECRET=affordable_balloons_super_secure_jwt_secret_2026
JWT_EXPIRE=7d

# Default Admin Seed Credentials
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@affordableballoons.com
ADMIN_PASSWORD=Admin@12345

# Cloudinary Credentials (Get these from your Cloudinary Dashboard: https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
